extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true

block content
	main#main-content.content
		.container
			.row
				.col-lg-6.offset-lg-3.col-xl-4.offset-xl-4
					.page-header
						if login_support_title
							h1 !{login_support_title}
						else
							h1 #{translate("log_in")} 
					form.card-body(action='/login/gitlab')
						button.btn-gitlab(type='submit')
							| SSO/Edugain with 
							img(src='/img/gitlab.svg', width='65px')
